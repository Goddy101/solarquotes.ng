---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 border-t border-gray-800 pt-16 pb-8 text-gray-400 text-sm mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      
      <!-- Brand & Mission -->
      <div class="col-span-1 md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-emerald-500 rounded flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <span class="text-xl font-bold text-white tracking-tight">Solar Quotes</span>
        </a>
        <p class="text-gray-400 leading-relaxed mb-6">
          Engineering Tier-1 hybrid solar arrays to eliminate diesel and petrol dependency across Nigeria.
        </p>
      </div>

      <!-- Core Solutions (Internal SEO Links) -->
      <div>
        <h3 class="text-white font-bold mb-4 uppercase tracking-wider text-xs">Solutions</h3>
        <ul class="space-y-3">
          <li><a href="/residential-solar-installation/fct/wuse" class="hover:text-emerald-400 transition-colors">Residential Home Solar</a></li>
          <li><a href="/commercial-solar-installation/lagos/victoria-island" class="hover:text-emerald-400 transition-colors">Commercial Hybrid Arrays</a></li>
          <li><a href="/industrial-load-balancing/kano/sharada" class="hover:text-emerald-400 transition-colors">Industrial Load Balancing</a></li>
          <li><a href="/solar-maintenance-and-repair/rivers/trans-amadi" class="hover:text-emerald-400 transition-colors">Maintenance & Repairs</a></li>
        </ul>
      </div>

      <!-- Regional Hubs -->
      <div>
        <h3 class="text-white font-bold mb-4 uppercase tracking-wider text-xs">Regional Hubs</h3>
        <ul class="space-y-3">
          <li><a href="/#locations" class="hover:text-emerald-400 transition-colors">FCT (Abuja)</a></li>
          <li><a href="/#locations" class="hover:text-emerald-400 transition-colors">Lagos State</a></li>
          <li><a href="/#locations" class="hover:text-emerald-400 transition-colors">Rivers State</a></li>
          <li><a href="/#locations" class="hover:text-emerald-400 transition-colors">Kano State</a></li>
        </ul>
      </div>

      <!-- Technical Dispatch Contact -->
      <div>
        <h3 class="text-white font-bold mb-4 uppercase tracking-wider text-xs">Technical Dispatch</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span class="font-mono text-gray-300">0803 000 0000</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span class="text-gray-300">dispatch@solarquotes.com.ng</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="text-gray-300">Central Business District, Abuja (HQ)</span>
          </li>
        </ul>
      </div>

    </div>

    <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs">
      <p>&copy; {currentYear} Solar Quotes Nigeria. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>