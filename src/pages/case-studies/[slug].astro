---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadCaptureForm from '../../components/react/LeadCaptureForm';
import { CASE_STUDIES, type CaseStudy } from '../../data/caseStudies';

export async function getStaticPaths() {
  return CASE_STUDIES.map((study: CaseStudy) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;

// AEO/SEO Schema Injection
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": study.title,
  "description": study.executiveSummary,
  "author": {
    "@type": "Organization",
    "name": "Solar Quotes Nigeria"
  },
  "about": {
    "@type": "Project",
    "name": study.title,
    "location": {
      "@type": "Place",
      "address": {
        "addressLocality": study.location.district,
        "addressRegion": study.location.state,
        "addressCountry": "NG"
      }
    }
  }
};
---

<BaseLayout title={`${study.title} | Case Studies | Solar Quotes Nigeria`} description={study.executiveSummary}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="mb-8">
      <a href="/case-studies" class="inline-flex items-center text-sm font-bold text-emerald-600 hover:text-emerald-700 transition-colors">
        <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Back to Portfolio
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- LEFT COLUMN: Engineering & Financial Brief -->
      <article class="lg:col-span-8">
        
        <!-- Header -->
        <header class="mb-10">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="bg-gray-900 text-white px-3 py-1 rounded text-xs font-bold uppercase tracking-widest">{study.market}</span>
            <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded text-xs font-bold uppercase tracking-widest">{study.clientIndustry}</span>
            <span class="text-sm font-medium text-gray-500 flex items-center gap-1">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              {study.location.district}, {study.location.state}
            </span>
          </div>
          <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight mb-6">
            {study.title}
          </h1>
          <p class="text-xl text-gray-600 leading-relaxed font-medium">
            {study.executiveSummary}
          </p>
        </header>

        <!-- Dynamic Headline Metrics Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
          {study.headlineMetrics.map((metric: {label: string, value: string}) => (
            <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm text-center">
              <p class="text-2xl font-extrabold text-emerald-600">{metric.value}</p>
              <p class="text-xs font-bold uppercase text-gray-500 mt-1">{metric.label}</p>
            </div>
          ))}
        </div>

        <!-- Narrative Section -->
        <div class="prose prose-lg max-w-none text-gray-600 mb-12">
          <h2 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <svg class="w-6 h-6 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            The Infrastructural Challenge
          </h2>
          <p>{study.infrastructuralChallenge}</p>
          
          <h2 class="text-2xl font-bold text-gray-900 mt-10 flex items-center gap-2">
            <svg class="w-6 h-6 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            Engineered Solution
          </h2>
          <p>{study.engineeringSolution}</p>
        </div>

        <!-- Deep Data: Architecture & Financials -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-gray-200 pt-12">
          
          <!-- System Specs -->
          <div class="bg-gray-50 rounded-2xl p-6 md:p-8 border border-gray-100">
            <h3 class="text-lg font-extrabold text-gray-900 mb-6 uppercase tracking-wider text-sm border-b border-gray-200 pb-3">System Architecture</h3>
            <dl class="space-y-4 text-sm">
              <div>
                <dt class="text-gray-500 font-semibold uppercase text-xs mb-1">Inverter Topology</dt>
                <dd class="font-bold text-gray-900">{study.architecture.inverterTopology}</dd>
              </div>
              <div>
                <dt class="text-gray-500 font-semibold uppercase text-xs mb-1">Battery Storage</dt>
                <dd class="font-bold text-gray-900">{study.architecture.batteryStorage}</dd>
              </div>
              <div>
                <dt class="text-gray-500 font-semibold uppercase text-xs mb-1">Solar Array</dt>
                <dd class="font-bold text-gray-900">{study.architecture.solarArray}</dd>
              </div>
              <div>
                <dt class="text-gray-500 font-semibold uppercase text-xs mb-1">Balance of System</dt>
                <dd class="font-bold text-gray-900">
                  <ul class="list-disc list-inside space-y-1 mt-1">
                    {study.architecture.balanceOfSystem.map((item: string) => <li>{item}</li>)}
                  </ul>
                </dd>
              </div>
            </dl>
          </div>

          <!-- Financial Impact -->
          <div class="bg-gray-900 rounded-2xl p-6 md:p-8 shadow-xl text-white">
            <h3 class="text-lg font-extrabold text-emerald-400 mb-6 uppercase tracking-wider text-sm border-b border-gray-700 pb-3">Financial Impact</h3>
            <dl class="space-y-5">
              <div class="flex justify-between items-end">
                <dt class="text-gray-400 font-semibold text-sm">Monthly Diesel Saved</dt>
                <dd class="font-bold text-xl">{study.financials.monthlyDieselAvoidedLiters.toLocaleString()} L</dd>
              </div>
              <div class="flex justify-between items-end">
                <dt class="text-gray-400 font-semibold text-sm">Monthly OpEx Reduction</dt>
                <dd class="font-bold text-emerald-400 text-xl">{study.financials.monthlyNairaSavings}</dd>
              </div>
              <div class="flex justify-between items-end">
                <dt class="text-gray-400 font-semibold text-sm">Projected 10-Yr ROI</dt>
                <dd class="font-bold text-xl">{study.financials.projected10YearROI}</dd>
              </div>
              <div class="flex justify-between items-end pt-4 border-t border-gray-700">
                <dt class="text-gray-300 font-bold uppercase text-sm">Internal Rate of Return</dt>
                <dd class="font-extrabold text-3xl text-emerald-500">{study.financials.irr}</dd>
              </div>
            </dl>
          </div>
        </div>

        <!-- Optional Testimonial -->
        {study.clientTestimonial && (
          <blockquote class="mt-12 bg-emerald-50 border-l-4 border-emerald-500 p-6 md:p-8 rounded-r-2xl">
            <p class="text-lg md:text-xl text-gray-800 font-medium italic mb-4">"{study.clientTestimonial.quote}"</p>
            <footer class="text-sm font-bold text-emerald-700 uppercase tracking-wide">
              &mdash; {study.clientTestimonial.role}
            </footer>
          </blockquote>
        )}

      </article>

      <!-- RIGHT COLUMN: Conversion Sticky Sidebar -->
      <aside class="lg:col-span-4 relative">
        <div class="sticky top-24 bg-white border border-gray-200 rounded-2xl shadow-xl overflow-hidden">
          <div class="h-2 w-full bg-gradient-to-r from-emerald-500 to-teal-400"></div>
          <div class="p-6 sm:p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-2">Request an Audit</h3>
            <p class="text-gray-500 text-sm mb-6">Connect with our {study.location.state} engineering team to model a similar deployment for your facility.</p>
            
            <!-- Passes the specific district safely into the React component -->
            <LeadCaptureForm client:load prefillService={`Audit: ${study.market} Hybrid`} prefillDistrict={study.location.district} />
            
            <div class="mt-6 pt-6 border-t border-gray-100">
               <p class="text-[10px] text-gray-400 uppercase tracking-wider font-bold text-center mb-3">Audits Include</p>
               <ul class="space-y-2 text-sm text-gray-600 font-medium">
                 <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Load Profiling</li>
                 <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Harmonic Distortion Check</li>
                 <li class="flex items-center gap-2"><svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Financial ROI Modeling</li>
               </ul>
            </div>
          </div>
        </div>
      </aside>
      
    </div>
  </main>
</BaseLayout>