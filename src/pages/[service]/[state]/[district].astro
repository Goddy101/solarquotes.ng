---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LeadCaptureForm from '../../../components/react/LeadCaptureForm';
import DieselRoiCalculator from '../../../components/react/DieselRoiCalculator'; 
import Breadcrumbs from '../../../components/astro/Breadcrumbs.astro';
import NearbyDistricts from '../../../components/astro/NearbyDistricts.astro';
import { supabase } from '../../../lib/supabase';

// 1. GENERATE ALL ROUTES AT BUILD TIME FROM SUPABASE
export async function getStaticPaths() {
  const { data: dbServices, error: servicesError } = await supabase
    .from('services')
    .select('*');

  if (servicesError) throw new Error(servicesError.message);

  const { data: activeDistricts, error: districtsError } = await supabase
    .from('districts')
    .select(`*, states (*)`)
    .eq('status', 'published');

  if (districtsError) throw new Error(districtsError.message);

  const paths = [];
  
  for (const dbService of dbServices) {
    for (const dbDistrict of activeDistricts) {
      const service = {
        slug: dbService.slug,
        title: dbService.title,
        market: dbService.market,
        schemaType: dbService.schema_type,
      };

      const state = {
        slug: dbDistrict.states.slug,
        name: dbDistrict.states.name,
        gridProvider: dbDistrict.states.grid_provider,
        dieselCostEstimate: dbDistrict.states.diesel_cost_estimate,
        environment: dbDistrict.states.environment, 
      };

      const district = {
        slug: dbDistrict.slug,
        name: dbDistrict.name,
        coordinates: dbDistrict.coordinates,
        gridBand: dbDistrict.grid_band,
        averageDailyOutage: dbDistrict.average_daily_outage,
        primaryGridIssue: dbDistrict.primary_grid_issue,
        commonHardwareFailures: dbDistrict.common_hardware_failures,
        targetSectors: dbDistrict.target_sectors,
        localLandmarks: dbDistrict.local_landmarks,
        financials: dbDistrict.financials, 
        slaDispatchMinutes: dbDistrict.sla_dispatch_minutes,
      };

      paths.push({
        params: { service: service.slug, state: state.slug, district: district.slug },
        props: { service, state, district },
      });
    }
  }
  
  return paths;
}

// 2. EXTRACT PROPS & CONTEXT
const { service, state, district } = Astro.props;
const isResidential = service.market === 'residential';
const isMaintenance = service.slug.includes('maintenance') || service.slug.includes('repair') || service.slug.includes('cleaning');
const marketPrefix = isMaintenance ? 'Technical' : (isResidential ? 'Home' : 'Commercial');

// Safe variable fallbacks to prevent build crashes
const landmark = district.localLandmarks?.[0] || district.name;
const sectors = district.targetSectors?.join(" and ") || "businesses";

// 3. COMBINATORIAL SPINTAX ENGINE (Zero-Boilerplate Architecture)
const spintax = {
  residential: {
    hooks: [
      `For homeowners and premium estates in the ${district.name} axis, `,
      `If you reside near ${landmark}, `,
      `Property owners in ${district.name} know firsthand that `,
      `Families living in the ${district.name} district are increasingly realizing that `
    ],
    agitations: [
      `enduring ${district.averageDailyOutage} of daily outages on the ${state.gridProvider} grid is no longer sustainable. `,
      `the relentless noise and soaring cost of petrol generators is destroying home comfort. `,
      `relying on unpredictable voltage from the ${district.gridBand} band actively damages expensive home appliances. `,
      `waking up to pitch-black nights due to persistent ${state.gridProvider} failures is a massive security risk. `
    ],
    solutions: [
      `It is time to upgrade your property's equity with a silent, zero-emission ${service.title.toLowerCase()} system.`,
      `We engineer Tier-1 solar microgrids that permanently eliminate petrol dependency for your household.`,
      `Our localized deployment team provides pure sine-wave inverter systems designed for optimal residential load balancing.`,
      `Stop burning cash on fuel. Transition to an SLA-backed solar array engineered for Nigeria's toughest grid environments.`
    ]
  },
  commercial: {
    hooks: [
      `For ${sectors} operating in the ${district.name} commercial hub, `,
      `Corporate facilities and heavy-load operations near ${landmark} understand that `,
      `In the competitive business landscape of ${district.name}, `,
      `Industrial and commercial managers relying on the ${district.name} axis know that `
    ],
    agitations: [
      `grid instability and ${district.averageDailyOutage} blackouts are a direct threat to operational profitability. `,
      `burning diesel at ${state.dieselCostEstimate} to mitigate ${state.gridProvider}'s unreliability is bleeding capital. `,
      `phase drops and severe voltage fluctuations on the ${district.gridBand} band cause catastrophic hardware failures. `,
      `unplanned downtime from ${district.primaryGridIssue} actively disrupts supply chains and client service. `
    ],
    solutions: [
      `We deploy enterprise-grade ${service.title.toLowerCase()} arrays with ${district.slaDispatchMinutes}-minute SLA support to guarantee zero downtime.`,
      `Our synchronized hybrid microgrids are specifically engineered to stabilize extreme phase imbalances and eliminate diesel costs.`,
      `Protect your bottom line with a high-capacity commercial solar infrastructure designed for heavy inductive loads.`,
      `We replace diesel generators with smart grid-tie inverter racks, providing medical-grade power security and massive ROI.`
    ]
  },
  maintenance: {
    hooks: [
      `Is your existing solar installation underperforming in ${district.name}? `,
      `If your inverter is throwing fault codes or batteries are draining too fast near ${landmark}, `,
      `For properties in ${district.name} dealing with degraded solar performance, `,
      `Don't let a poorly maintained solar setup leave you in the dark during ${state.gridProvider} outages. `
    ],
    agitations: [
      `Severe dust buildup on panels can secretly reduce your energy yield by up to 40%. `,
      `Degraded lithium racks and poor cabling actively create fire hazards and system bottlenecks. `,
      `Ignoring routine diagnostic checks often turns minor ${district.primaryGridIssue} impacts into catastrophic inverter failures. `,
      `Many legacy systems suffer from improper load-balancing, causing them to trip immediately when the grid fails. `
    ],
    solutions: [
      `Our rapid-dispatch technical team provides SLA-backed panel washing, thermal imaging, and fault tracing.`,
      `We offer professional ${service.title.toLowerCase()} to restore your array to 100% factory-rated efficiency.`,
      `Book a comprehensive engineering audit. We handle battery cell balancing, firmware updates, and total system optimization.`,
      `Our engineers are on standby in ${state.name} to execute rapid inverter repairs, re-wiring, and OEM hardware upgrades.`
    ]
  }
};

// 4. DETERMINISTIC HASHING (Guarantees the same URL always gets the exact same copy)
// We use the ASCII values of the district and service slugs to generate a permanent, unique index.
const hash = district.slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0) + 
             service.slug.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);

const marketKey = isMaintenance ? 'maintenance' : (isResidential ? 'residential' : 'commercial');
const activeSpintax = spintax[marketKey];

const hookIndex = hash % activeSpintax.hooks.length;
const agitationIndex = (hash * 2) % activeSpintax.agitations.length;
const solutionIndex = (hash * 3) % activeSpintax.solutions.length;

const dynamicIntro = 
  activeSpintax.hooks[hookIndex] + 
  activeSpintax.agitations[agitationIndex] + 
  activeSpintax.solutions[solutionIndex];

// 4. THE DETERMINISTIC IMAGE MATRIX (R2 Bucket)
const CDN_URL = 'https://cdn.solarquotes.com.ng'; 

const commercialImages = [
  `${CDN_URL}/commercial-1.webp`,
  `${CDN_URL}/commercial-2.webp`,
  `${CDN_URL}/commercial-3.webp`,
  `${CDN_URL}/commercial-4.webp`,
  `${CDN_URL}/commercial-5.webp`,
];

const residentialImages = [
  `${CDN_URL}/residential-1.webp`,
  `${CDN_URL}/residential-2.webp`,
  `${CDN_URL}/residential-3.webp`,
  `${CDN_URL}/residential-4.webp`,
  `${CDN_URL}/residential-5.webp`,
];

const imagePool = isResidential ? residentialImages : commercialImages;
const stringHash = service.slug.length + district.name.length;
const imageIndex = stringHash % imagePool.length;
const dynamicHeroImage = imagePool[imageIndex];

// 5. ENRICHED GEO & AI SCHEMA
const pageTitle = `${marketPrefix} ${service.title} in ${district.name}, ${state.name} | Solar Quotes`;
const metaDescription = isResidential 
  ? `Stop burning petrol during ${district.averageDailyOutage} outages on ${state.gridProvider}. We provide silent, zero-emission ${service.title.toLowerCase()} near ${district.localLandmarks[0]}.`
  : `Stop losing capital to ${district.averageDailyOutage} outages on ${state.gridProvider}. We provide enterprise ${service.title.toLowerCase()} near ${district.localLandmarks[0]} with a ${district.slaDispatchMinutes}-min SLA.`;

const schema = {
  "@context": "https://schema.org",
  "@type": service.schemaType,
  "name": `${marketPrefix} ${service.title} in ${district.name}`,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Solar Quotes Nigeria",
    "image": "https://solarquotes.com.ng/logo.png",
    "telephone": "+2349168399707",
    "priceRange": "$$$",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": district.name,
      "addressRegion": state.name,
      "addressCountry": "NG"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": district.coordinates?.lat || "9.0765",
      "longitude": district.coordinates?.lng || "7.3986"
    }
  },
  "areaServed": {
    "@type": "Place",
    "name": district.name
  },
  "description": metaDescription
};

// 6. GENERATE THE DYNAMIC OG IMAGE URL
const encodedTitle = encodeURIComponent(`${service.title} in ${district.name}`);
const encodedSubtitle = encodeURIComponent(`${district.slaDispatchMinutes}-Min SLA Dispatch`);
const bgFilename = dynamicHeroImage.split('/').pop(); 
const ogImageUrl = `https://solarquotes.com.ng/og?title=${encodedTitle}&subtitle=${encodedSubtitle}&bg=${bgFilename}`;
---

<!-- THE FIX: Pass schema directly to BaseLayout so it goes into the <head> -->
<BaseLayout title={pageTitle} description={metaDescription} ogImage={ogImageUrl} schema={schema}>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs 
      currentService={service.title} 
      currentState={state.name} 
      currentDistrict={district.name} 
    />
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mt-10">
      
      <!-- LEFT COL: Dynamic Sales & Engineering Copy -->
      <section class="lg:col-span-7 space-y-10">
        <div>
          <div class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-800 mb-4">
            <span class="flex h-2 w-2 rounded-full bg-emerald-600 mr-2 animate-pulse"></span>
            SLA: {district.slaDispatchMinutes}-Minute Dispatch to {district.name}
          </div>
          <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900 leading-tight mb-8">
            {marketPrefix} <span class="text-emerald-600">{service.title}</span> in {district.name}
          </h1>

          <!-- Dynamic Local Edge Image -->
          <div class="w-full h-64 md:h-80 rounded-2xl overflow-hidden shadow-lg mb-8 relative bg-gray-200">
             <img 
               src={dynamicHeroImage} 
               alt={`${service.title} installed in ${district.name}, ${state.name}`} 
               loading="eager"
               class="object-cover w-full h-full" 
             />
             <div class="absolute inset-0 bg-gradient-to-t from-gray-900/40 to-transparent pointer-events-none"></div>
          </div>
        </div>
        
        <!-- Pain Point Agitation -->
        <div class="prose prose-lg text-gray-600 max-w-none">
           <p>{dynamicIntro}</p>
           <p>
             Currently, infrastructure on <strong>{state.gridProvider} {district.gridBand}</strong> is experiencing an average of <strong>{district.averageDailyOutage} of daily outages</strong>. 
             {!isResidential && `Running a ${district.financials.typicalSystemSize} generator is costing businesses upwards of ₦${district.financials.estDieselSavings} in wasted capital every month.`}
           </p>
        </div>

        <!-- Conditionally Render ROI Calculator for Commercial Only -->
        {!isResidential && (
          <div class="mt-8 mb-12">
            <DieselRoiCalculator 
              client:visible 
              districtName={district.name}
              dieselCostEstimate={state.dieselCostEstimate}
              averageDailyOutage={district.averageDailyOutage}
              bandTariffKwh={district.financials.bandTariffKwh}
            />
          </div>
        )}

        <!-- THE FIX: AI-Optimized Semantic Data Table -->
        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
          <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-bold text-gray-900 flex items-center">
              <svg class="h-5 w-5 text-emerald-600 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
              Localized Engineering Data: {district.name}
            </h3>
          </div>
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <tbody class="divide-y divide-gray-200 bg-white">
              <tr class="hover:bg-gray-50 transition-colors">
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900 text-left w-1/3">Utility Grid Band</th>
                <td class="px-6 py-4 text-gray-700">{district.gridBand} ({state.gridProvider})</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900 text-left">Average Outage Duration</th>
                <td class="px-6 py-4 text-gray-700 font-medium text-red-600">{district.averageDailyOutage}</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900 text-left">Primary Grid Issue</th>
                <td class="px-6 py-4 text-gray-700">{district.primaryGridIssue}</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900 text-left">Mitigated Hardware Risks</th>
                <td class="px-6 py-4 text-gray-700">{district.commonHardwareFailures.join(" & ")}</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <th scope="row" class="px-6 py-4 font-semibold text-gray-900 text-left">SLA Response Target</th>
                <td class="px-6 py-4 text-gray-700 font-medium text-emerald-600">{district.slaDispatchMinutes} Minutes</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- RIGHT COL: Conversion Island -->
      <aside class="lg:col-span-5 relative">
        <div class="sticky top-28 bg-white p-8 rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1.5 bg-emerald-500"></div>
          
          <h3 class="text-2xl font-bold text-gray-900 mb-2">
            {isResidential ? "Get a Home Solar Quote" : "Book a Commercial Audit"}
          </h3>
          <p class="text-gray-500 mb-6 text-sm">
            Bypass the call center. Connect directly with our {state.name} technical dispatch via WhatsApp.
          </p>
          
        <!-- React Island: Hydrates only this form -->
          <LeadCaptureForm 
            client:load 
            prefillService={service.title} 
            prefillDistrict={district.name}
            formType={isMaintenance ? 'maintenance' : 'installation'} 
          />
          
          <div class="mt-6 pt-6 border-t border-gray-100 text-center">
             <p class="text-xs text-gray-400 uppercase tracking-wider font-semibold">Audits include</p>
             <div class="flex justify-center gap-4 mt-3 text-sm text-gray-600 font-medium">
               <span>✓ Load Profiling</span>
               <span>{isResidential ? '✓ Roof Assessment' : '✓ Phase Balancing'}</span>
             </div>
          </div>
        </div>
      </aside>

    </div>
  </main>

  <NearbyDistricts 
    currentServiceSlug={service.slug}
    currentStateSlug={state.slug}
    currentDistrictSlug={district.slug}
  />
</BaseLayout>