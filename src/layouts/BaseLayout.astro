---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

// THE FIX: We must extract ogImage here and give it a fallback!
const { 
  title, 
  description,
  ogImage = 'https://solarquotes.com.ng/og?title=Tier%201%20Solar%20Engineering&subtitle=Solar%20Quotes%20Nigeria'
} = Astro.props;

// Your central dispatch number for the sticky CTAs
const WHATSAPP_NUMBER = "2349168399707"; 
const WHATSAPP_LINK = `https://wa.me/2349168399707?text=Hello%20Solar%20Quotes,%20I%20am%20interested%20in%20a%20solar%20audit.`;
---
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />


    <meta property="og:image" content={ogImage} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    
    <!-- Open Graph for Social Sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  
  <body class="flex flex-col min-h-screen bg-white text-gray-900 antialiased selection:bg-emerald-500 selection:text-white">
    
    {/* ACCESSIBILITY: Skip to main content */}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-emerald-600 text-white px-4 py-2 z-50 rounded-lg">
      Skip to main content
    </a>

    {/* HEADER / NAVIGATION */}
    <header class="sticky top-0 z-40 w-full bg-white/90 backdrop-blur-md border-b border-gray-100 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
          
          {/* BRAND LOGO */}
          <div class="flex-shrink-0 flex items-center">
            <a href="/" class="flex items-center gap-2 group">
              <div class="bg-gray-900 text-white p-2 rounded-lg group-hover:bg-emerald-600 transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              </div>
              <span class="font-extrabold text-xl tracking-tight text-gray-900">Solar Quotes</span>
            </a>
          </div>

          {/* DESKTOP NAV */}
          <nav class="hidden md:flex space-x-8">
            <a href="/#coverage" class="text-gray-600 hover:text-emerald-600 font-medium transition-colors">Engineering Zones</a>
            <a href="/#case-studies" class="text-gray-600 hover:text-emerald-600 font-medium transition-colors">Case Studies</a>
          </nav>

          {/* GLOBAL CTA */}
          <div class="flex items-center">
            <a 
              href={WHATSAPP_LINK}
              target="_blank"
              rel="noopener noreferrer" 
              class="hidden sm:inline-flex items-center justify-center px-6 py-2.5 border border-transparent rounded-lg shadow-sm text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 transition-all"
            >
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              Technical Dispatch
            </a>
          </div>
        </div>
      </div>
    </header>

    {/* MAIN CONTENT SLOT */}
    <div id="main-content" class="flex-grow">
      <slot />
    </div>

    {/* FOOTER */}
    <footer class="bg-gray-900 pt-16 pb-8 border-t border-gray-800 text-gray-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
          
          {/* Brand Info */}
          <div>
            <div class="flex items-center gap-2 mb-6">
              <div class="bg-emerald-600 text-white p-1.5 rounded-lg">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              </div>
              <span class="font-extrabold text-xl tracking-tight text-white">Solar Quotes</span>
            </div>
            <p class="text-sm leading-relaxed text-gray-400">
              Engineering Tier-1 hybrid solar arrays to eliminate diesel and petrol dependency across Nigeria.
            </p>
          </div>

          {/* Dynamic Service Links */}
          <div>
            <h4 class="text-white font-bold mb-6 uppercase tracking-wider text-sm">Solutions</h4>
            <ul class="space-y-3 text-sm">
              <li><a href="/#coverage" class="hover:text-emerald-400 transition-colors">Residential Home Backup</a></li>
              <li><a href="/#coverage" class="hover:text-emerald-400 transition-colors">Commercial Hybrid Arrays</a></li>
              <li><a href="/#coverage" class="hover:text-emerald-400 transition-colors">Industrial Load Balancing</a></li>
              <li><a href="/#coverage" class="hover:text-emerald-400 transition-colors">Maintenance & Repairs SLA</a></li>
            </ul>
          </div>

          {/* Regional Hubs (Mapped to your DB) */}
          <div>
            <h4 class="text-white font-bold mb-6 uppercase tracking-wider text-sm">Regional Hubs</h4>
            <ul class="space-y-3 text-sm">
              <li><span class="text-emerald-500 mr-2">●</span> FCT (Abuja)</li>
              <li><span class="text-emerald-500 mr-2">●</span> Lagos State</li>
              <li><span class="text-emerald-500 mr-2">●</span> Rivers State</li>
              <li><span class="text-emerald-500 mr-2">●</span> Kano State</li>
            </ul>
          </div>

          {/* Contact */}
          <div>
            <h4 class="text-white font-bold mb-6 uppercase tracking-wider text-sm">Technical Dispatch</h4>
            <ul class="space-y-4 text-sm">
              <li class="flex items-start">
                <svg class="w-5 h-5 text-gray-500 mr-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                {WHATSAPP_NUMBER}
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-gray-500 mr-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                dispatch@solarquotes.com.ng
              </li>
              <li class="flex items-start">
                <svg class="w-5 h-5 text-gray-500 mr-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                Central Business District, Abuja (HQ)
              </li>
            </ul>
          </div>

        </div>

        <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center text-xs">
          <p>&copy; {new Date().getFullYear()} Solar Quotes Nigeria. All rights reserved.</p>
          <div class="flex space-x-4 mt-4 md:mt-0">
            <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
            <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
          </div>
        </div>
      </div>
    </footer>

  </body>
</html>